{
  "functions": { "api/planner.js": { "maxDuration": 90 } },
  "rewrites": [
    {
      "source": "/slug/:id",
      "destination": "/index.html"
    },
    {
      "source": "/slug/:id/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/play/local/:id",
      "destination": "/index.html"
    },
    {
      "source": "/play/local/:id/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/play/:id",
      "destination": "/index.html"
    },
    {
      "source": "/play/:id/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/s/:id",
      "destination": "/index.html"
    },
    {
      "source": "/draw",
      "destination": "/index.html"
    },
    {
      "source": "/draw/",
      "destination": "/index.html"
    }
  ],
  "trailingSlash": false
}
